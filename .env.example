# Proveedor del texto de «Interpretar»: anthropic | gemini.
# Si se deja vacío, se usa Anthropic si hay ANTHROPIC_API_KEY y, si no, Gemini si hay GEMINI_API_KEY.
# Sin ninguna key, la app muestra el resumen automático.
AI_PROVIDER=
# Clave de la API de Anthropic (console.anthropic.com).
ANTHROPIC_API_KEY=
# Clave de la API de Gemini (Google AI Studio). El tier gratuito usa el contenido para mejorar los productos de Google.
GEMINI_API_KEY=
# Modelo opcional del proveedor elegido. Por defecto: claude-haiku-5-5 o gemini-3.5-flash-lite.
AI_MODEL=
