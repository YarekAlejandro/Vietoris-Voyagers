# Proveedor de «Interpretar» y «Asistente»: anthropic (o claude) | gemini.
# Si se deja vacío, se usa Anthropic si hay ANTHROPIC_API_KEY y, si no, Gemini si hay GEMINI_API_KEY.
# Sin ninguna key, la app usa el motor local.
AI_PROVIDER=
# Clave de la API de Anthropic (console.anthropic.com).
ANTHROPIC_API_KEY=
# Clave de la API de Gemini (Google AI Studio). El tier gratuito usa el contenido para mejorar los productos de Google.
GEMINI_API_KEY=
# Modelo opcional del proveedor elegido. Por defecto: claude-haiku-5-5 o gemini-3.5-flash-lite.
AI_MODEL=

# Voz del asistente. Configura estas variables en el servidor.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# API pública de NASA PSI. La ruta admite term, size y from; el filtro de disciplina se aplica en la app.
PSI_API_BASE=https://psi.nasa.gov/geode-py/ws
PSI_SEARCH_PATH=/repo/search
# Solo CSV experimentales públicos de hasta 300 KB con columnas verificadas.
ENABLE_PSI_TABLES=false
# Escena opcional en fichas de corridas compatibles. Usa false para ocultarla.
NEXT_PUBLIC_EXPERIMENT_SCENE=true
