{
  "name": "aether-si",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "eval": "vitest run --config eval/vitest.config.mjs",
    "build": "next build",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && node --check scripts/probe-psi-api.mjs && node --check scripts/build-psi-snapshot.mjs",
    "typecheck": "tsc --noEmit",
    "snapshot:psi": "node --env-file-if-exists=.env.local scripts/build-psi-snapshot.mjs",
    "test": "vitest run --pool=threads"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
